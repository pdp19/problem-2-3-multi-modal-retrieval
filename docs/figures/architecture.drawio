<mxfile host="app.diagrams.net"><diagram name="Architecture" id="arch"><mxGraphModel dx="1200" dy="600" grid="1" gridSize="10" page="1" pageWidth="1240" pageHeight="600"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="g0" value="Ingest: Pixeltable tables, views, computed columns, embedding indexes (incremental per meeting)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=8;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="15" y="30" width="640" height="295" as="geometry"/></mxCell><mxCell id="g1" value="Query (CPU, p50 14-30 ms warm)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=8;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="15" y="365" width="1060" height="180" as="geometry"/></mxCell><mxCell id="video" value="&lt;b&gt;Meeting video&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;overhead camera&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#555555;fillColor=#f2f2f0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="150" height="54" as="geometry"/></mxCell><mxCell id="slides" value="&lt;b&gt;Slide captures&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;file name = on-screen time&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#555555;fillColor=#f2f2f0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="160" width="150" height="54" as="geometry"/></mxCell><mxCell id="words" value="&lt;b&gt;Timed words + speakers&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;AMI words (any ASR)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#555555;fillColor=#f2f2f0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="250" width="150" height="54" as="geometry"/></mxCell><mxCell id="frames" value="&lt;b&gt;frames view&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;frame_iterator(fps=0.2)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#555555;fillColor=#e6eef8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="70" width="170" height="54" as="geometry"/></mxCell><mxCell id="ocr" value="&lt;b&gt;slides table&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;image + OCR computed column&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#555555;fillColor=#e6eef8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="160" width="170" height="54" as="geometry"/></mxCell><mxCell id="clips" value="&lt;b&gt;clips table&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;~45 s, cut at slide change / pause&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#555555;fillColor=#e6eef8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="250" width="170" height="54" as="geometry"/></mxCell><mxCell id="fidx" value="&lt;b&gt;CLIP frame index&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;(measured: no value, weight 0)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#555555;fillColor=#cfe0f3;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="70" width="180" height="54" as="geometry"/></mxCell><mxCell id="sclip" value="&lt;b&gt;CLIP slide-image index&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#555555;fillColor=#cfe0f3;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="138" width="180" height="40" as="geometry"/></mxCell><mxCell id="socr" value="&lt;b&gt;slide-text index (bge) + BM25&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#555555;fillColor=#cfe0f3;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="188" width="180" height="40" as="geometry"/></mxCell><mxCell id="cidx" value="&lt;b&gt;clip-text index (bge) + BM25&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;transcript + slide OCR&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#555555;fillColor=#cfe0f3;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="250" width="180" height="54" as="geometry"/></mxCell><mxCell id="q" value="&lt;b&gt;Question&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;+ team workspace&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#555555;fillColor=#fbf1dc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="440" width="150" height="54" as="geometry"/></mxCell><mxCell id="router" value="&lt;b&gt;Intent router&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;names an artifact? -&gt; visual&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#555555;fillColor=#fbf1dc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="440" width="170" height="54" as="geometry"/></mxCell><mxCell id="speech" value="&lt;b&gt;speech: BM25 + 0.25 dense&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;over clips&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#555555;fillColor=#fbf1dc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="400" width="180" height="46" as="geometry"/></mxCell><mxCell id="visual" value="&lt;b&gt;visual: rank slides first&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;OCR + CLIP + BM25 -&gt; best clip&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#555555;fillColor=#fbf1dc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="470" width="180" height="54" as="geometry"/></mxCell><mxCell id="rrf" value="&lt;b&gt;Weighted RRF&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;scoped to the team&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#555555;fillColor=#fbf1dc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="690" y="435" width="150" height="54" as="geometry"/></mxCell><mxCell id="ans" value="&lt;b&gt;Answer&lt;/b&gt;&lt;br&gt;&l